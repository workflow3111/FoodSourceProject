# Local application URL. Used for metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime connection used by the Prisma driver adapter in the Next.js app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodsource

# Direct connection used by Prisma CLI migrations.
# A local Postgres instance can use the same value as DATABASE_URL.
# Hosted Postgres often uses a pooled DATABASE_URL and a non-pooled DIRECT_URL.
# Add ?sslmode=require when the provider requires TLS.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/foodsource
