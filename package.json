{
  "name": "foodsource",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "test:matching": "node --import ./scripts/register-loader.mjs scripts/run-matching-test.mjs",
    "test:freshness": "node --import ./scripts/register-loader.mjs scripts/run-freshness-test.mjs",
    "test:csv": "node --import ./scripts/register-loader.mjs scripts/run-csv-test.mjs",
    "test:certificates": "node --import ./scripts/register-loader.mjs scripts/run-certificate-test.mjs",
    "test:product-type": "node --import ./scripts/register-loader.mjs scripts/run-product-type-test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
